#!/bin/sh
# Typecheck first (fail fast on type errors before running tests)
npm run typecheck

# Run the suite with coverage and rebuild the badges, so the numbers in
# the tree describe the tree. Nothing writes them back for you any more:
# CI compares a fresh run against what this commit carries, and a
# summary left behind fails there instead of here, where it costs one
# command to fix.
# Bump heap for ts-morph-heavy adapter + CLI tests running in parallel.
NODE_OPTIONS="--max-old-space-size=8192" npm run test:coverage
npm run badges

MOVED=$(git status --porcelain -- .github/badges '**/coverage/coverage-summary.json')
if [ -n "$MOVED" ]; then
  echo "Coverage moved. Commit the refreshed summaries and badges so the"
  echo "figures land in the pull request diff next to what changed them:"
  echo "$MOVED"
  exit 1
fi
