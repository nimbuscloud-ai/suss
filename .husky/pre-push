#!/bin/sh
set -e

# Typecheck first (fail fast on type errors before running tests)
npm run typecheck

# Run the suite with coverage and rebuild the badges, so a fresh run is
# on disk to check this commit against. Coverage holding or rising needs
# no commit, since main regenerates the committed summaries and badges
# after every merge. Only a drop below what this commit already carries
# fails, and the fix is the same one check:coverage names: rerun and
# commit the refreshed figures.
# Bump heap for ts-morph-heavy adapter + CLI tests running in parallel.
NODE_OPTIONS="--max-old-space-size=8192" npm run test:coverage
npm run badges

node scripts/checkCoverageBaseline.mjs
