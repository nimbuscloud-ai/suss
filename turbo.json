{
  "$schema": "https://turbo.build/schema.json",
  // The cache server's address arrives as TURBO_API, so only the settings
  // that are the same everywhere live here. teamId is a namespace the
  // server keys artifacts under, not a credential.
  "remoteCache": {
    "signature": true,
    "teamId": "team_suss",
    "timeout": 10,
    "uploadTimeout": 20
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "!coverage/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "!coverage/**"]
    },
    "lint": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!coverage/**"]
    },
    "lint:fix": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!coverage/**"]
    },
    "check:self": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": false
    }
  }
}
