{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "!coverage/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!coverage/**",
        "$TURBO_ROOT$/vitest.shared.ts"
      ]
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!coverage/**",
        "$TURBO_ROOT$/vitest.shared.ts"
      ]
    },
    "lint": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!coverage/**"]
    },
    "lint:fix": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!coverage/**"],
      "cache": false
    },
    "check:self": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": false
    }
  }
}
