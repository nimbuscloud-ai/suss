{
  "name": "@suss/intent-ir",
  "version": "0.32.0",
  "type": "module",
  "description": "The types for the intent your team writes down, product outcomes and system behavior, in a shape suss can check the code against.",
  "keywords": [
    "suss",
    "static-analysis",
    "intent",
    "prd",
    "specification",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Nimbus Cloud AI LLC",
  "homepage": "https://github.com/nimbuscloud-ai/suss/tree/main/packages/intent-ir#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimbuscloud-ai/suss.git",
    "directory": "packages/intent-ir"
  },
  "bugs": {
    "url": "https://github.com/nimbuscloud-ai/suss/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema/intent-doc.schema.json": "./schema/intent-doc.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/generate-schema.mjs && npx biome format --write schema/intent-doc.schema.json",
    "schema:generate": "node scripts/generate-schema.mjs && npx biome format --write schema/intent-doc.schema.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@suss/ir-core": "0.32.0"
  },
  "devDependencies": {
    "tsup": "*",
    "typescript": "*",
    "vitest": "*",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
