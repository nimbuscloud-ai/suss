{
  "name": "@suss/contract-storybook",
  "version": "0.22.4",
  "type": "module",
  "description": "Turn Storybook CSF stories into a suss contract and check the props they pass against the React components that receive them.",
  "keywords": [
    "suss",
    "static-analysis",
    "storybook",
    "csf",
    "react",
    "api-contract",
    "api-drift"
  ],
  "license": "Apache-2.0",
  "author": "Nimbus Cloud AI LLC",
  "homepage": "https://github.com/nimbuscloud-ai/suss/tree/main/packages/contract/storybook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimbuscloud-ai/suss.git",
    "directory": "packages/contract/storybook"
  },
  "bugs": {
    "url": "https://github.com/nimbuscloud-ai/suss/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@suss/adapter-typescript": "0.22.4",
    "@suss/behavioral-ir": "0.22.4"
  },
  "devDependencies": {
    "tsup": "*",
    "typescript": "*",
    "vitest": "*",
    "ts-morph": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "ts-morph": "^23.0.0"
  }
}
