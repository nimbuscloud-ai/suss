{
  "name": "@suss/contract-cloudformation",
  "version": "0.22.1",
  "type": "module",
  "description": "Generate suss behavioral summaries from AWS CloudFormation / SAM templates with embedded API Gateway OpenAPI definitions.",
  "keywords": [
    "suss",
    "behavioral-summary",
    "aws",
    "cloudformation",
    "sam",
    "api-gateway",
    "openapi"
  ],
  "license": "Apache-2.0",
  "author": "Nimbus Cloud AI LLC",
  "homepage": "https://github.com/nimbuscloud-ai/suss/tree/main/packages/contract/cloudformation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimbuscloud-ai/suss.git",
    "directory": "packages/contract/cloudformation"
  },
  "bugs": {
    "url": "https://github.com/nimbuscloud-ai/suss/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@suss/behavioral-ir": "0.22.1",
    "@suss/contract-aws-apigateway": "0.22.1",
    "@suss/contract-openapi": "0.22.1",
    "@suss/ir-core": "0.22.1",
    "@suss/manifest-aws": "0.22.1",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@suss/checker": "*",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
