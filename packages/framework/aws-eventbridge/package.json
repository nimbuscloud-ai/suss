{
  "name": "@suss/framework-aws-eventbridge",
  "version": "0.5.4",
  "type": "module",
  "description": "Recognize AWS EventBridge PutEvents producer calls in TypeScript code and emit message-bus interaction effects.",
  "keywords": [
    "suss",
    "behavioral-summary",
    "eventbridge",
    "aws",
    "events",
    "messaging"
  ],
  "license": "Apache-2.0",
  "author": "Nimbus Cloud AI LLC",
  "homepage": "https://github.com/nimbuscloud-ai/suss/tree/main/packages/framework/aws-eventbridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimbuscloud-ai/suss.git",
    "directory": "packages/framework/aws-eventbridge"
  },
  "bugs": {
    "url": "https://github.com/nimbuscloud-ai/suss/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "ts-morph": ">=20"
  },
  "dependencies": {
    "@suss/adapter-typescript": "0.5.4",
    "@suss/behavioral-ir": "0.5.4",
    "@suss/extractor": "0.5.4"
  },
  "devDependencies": {
    "@suss/test-project": "*",
    "ts-morph": "*",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
