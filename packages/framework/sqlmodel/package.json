{
  "name": "@suss/framework-sqlmodel",
  "version": "0.30.0",
  "type": "module",
  "description": "Pattern pack that says which SQLModel calls a Python body makes against the database.",
  "keywords": [
    "suss",
    "behavioral-summary",
    "framework-pack",
    "sqlmodel",
    "sqlalchemy",
    "fastapi",
    "python",
    "static-analysis"
  ],
  "license": "Apache-2.0",
  "author": "Nimbus Cloud AI LLC",
  "homepage": "https://github.com/nimbuscloud-ai/suss/tree/main/packages/framework/sqlmodel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimbuscloud-ai/suss.git",
    "directory": "packages/framework/sqlmodel"
  },
  "bugs": {
    "url": "https://github.com/nimbuscloud-ai/suss/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@suss/adapter-python": "0.30.0",
    "@suss/extractor": "0.30.0",
    "@suss/framework-sqlalchemy": "0.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@suss/behavioral-ir": "*",
    "@suss/checker": "*",
    "@suss/ir-core": "*",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "private": true
}
