{
  "name": "@suss/framework-aws-lambda",
  "version": "0.13.2",
  "type": "module",
  "description": "Pattern pack for extracting suss behavioral summaries from AWS Lambda HTTP handlers, paired to SAM/CloudFormation-declared routes.",
  "keywords": [
    "suss",
    "behavioral-summary",
    "framework-pack",
    "aws",
    "lambda",
    "sam",
    "api-gateway",
    "static-analysis"
  ],
  "license": "Apache-2.0",
  "author": "Nimbus Cloud AI LLC",
  "homepage": "https://github.com/nimbuscloud-ai/suss/tree/main/packages/framework/aws-lambda#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimbuscloud-ai/suss.git",
    "directory": "packages/framework/aws-lambda"
  },
  "bugs": {
    "url": "https://github.com/nimbuscloud-ai/suss/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "ts-morph": "^23.0.0"
  },
  "dependencies": {
    "@suss/adapter-typescript": "0.13.2",
    "@suss/manifest-aws": "0.13.2",
    "@suss/extractor": "0.13.2"
  },
  "devDependencies": {
    "@suss/behavioral-ir": "*",
    "@suss/test-project": "*",
    "ts-morph": "*",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "private": true
}
