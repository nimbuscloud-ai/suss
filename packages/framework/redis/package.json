{
  "name": "@suss/framework-redis",
  "version": "0.22.2",
  "type": "module",
  "description": "Says which Redis keys a TypeScript service reads and writes.",
  "keywords": [
    "suss",
    "behavioral-summary",
    "redis",
    "valkey",
    "storage"
  ],
  "license": "Apache-2.0",
  "author": "Nimbus Cloud AI LLC",
  "homepage": "https://github.com/nimbuscloud-ai/suss/tree/main/packages/framework/redis#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimbuscloud-ai/suss.git",
    "directory": "packages/framework/redis"
  },
  "bugs": {
    "url": "https://github.com/nimbuscloud-ai/suss/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@suss/recognize": "0.22.2"
  },
  "devDependencies": {
    "@suss/adapter-typescript": "*",
    "@suss/behavioral-ir": "*",
    "@suss/extractor": "*",
    "@suss/pack-harness": "*",
    "@suss/test-project": "*",
    "ts-morph": "*",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "private": true
}
