{
  "name": "@suss/cli",
  "version": "0.12.0",
  "type": "module",
  "description": "Command-line interface for suss: extract, inspect, diff, and check TypeScript behavioral summaries.",
  "keywords": [
    "suss",
    "cli",
    "behavioral-summary",
    "static-analysis",
    "contract-testing",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Nimbus Cloud AI LLC",
  "homepage": "https://github.com/nimbuscloud-ai/suss/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimbuscloud-ai/suss.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/nimbuscloud-ai/suss/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "suss": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check:self": "node ../../scripts/checkSelf.mjs"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@iarna/toml": "^2.2.5",
    "@suss/adapter-python": "0.12.0",
    "@suss/adapter-ruby": "0.12.0",
    "@suss/adapter-typescript": "0.12.0",
    "@suss/behavioral-ir": "0.12.0",
    "@suss/checker": "0.12.0",
    "@suss/checker-intent": "0.12.0",
    "@suss/contract-appsync": "0.12.0",
    "@suss/contract-aws-apigateway": "0.12.0",
    "@suss/contract-cloudformation": "0.12.0",
    "@suss/contract-graphql": "0.12.0",
    "@suss/contract-intent": "0.12.0",
    "@suss/contract-openapi": "0.12.0",
    "@suss/contract-prisma": "0.12.0",
    "@suss/contract-serverless": "0.12.0",
    "@suss/contract-storybook": "0.12.0",
    "@suss/contract-terraform": "0.12.0",
    "@suss/contract-wrangler": "0.12.0",
    "@suss/datalog": "0.12.0",
    "@suss/extractor": "0.12.0",
    "@suss/intent-ir": "0.12.0",
    "@suss/packs": "0.12.0",
    "@suss/terraform-aws": "0.12.0",
    "@suss/terraform-gcp": "0.12.0",
    "pip-requirements-js": "^1.0.3",
    "ts-morph": "^23.0.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@aws-sdk/client-eventbridge": "^3.1037.0",
    "@aws-sdk/client-sqs": "^3.1037.0",
    "@suss/test-project": "*",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
