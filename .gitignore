node_modules/
# A fixture project's node_modules is stub type declarations for the
# libraries its code imports, written by hand and meant to be committed.
!fixtures/*/node_modules/
dist/
.turbo/
*.tsbuildinfo
.env
**/coverage/*
!**/coverage/coverage-summary.json
!packages/checker/src/coverage/**

# VitePress
docs/.vitepress/dist/
docs/.vitepress/cache/

# Dogfood output (regenerated on demand via `node scripts/dogfood.mjs`)
scripts/dogfood-report.json

# Self-check summaries (regenerated on demand via `npm run check:self`)
.self-check/

# Per-package extraction cache (local to each working tree)
**/.suss/

# External dogfood targets, cloned to the repo root for ad-hoc
# end-to-end runs. Clone them under this directory so they stay ignored
# without anyone editing this file to name one.
/dogfood-targets

