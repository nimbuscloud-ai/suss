{
  "name": "suss",
  "version": "0.22.3",
  "private": true,
  "type": "module",
  "description": "Static behavioral analysis for TypeScript — extract, compare, and publish summaries of what your code does.",
  "license": "Apache-2.0",
  "author": "Nimbus Cloud AI LLC",
  "homepage": "https://github.com/nimbuscloud-ai/suss#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimbuscloud-ai/suss.git"
  },
  "bugs": {
    "url": "https://github.com/nimbuscloud-ai/suss/issues"
  },
  "workspaces": [
    "packages/*",
    "packages/*/*",
    "tools/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@prisma/client": "^6.19.3",
    "@vitest/coverage-v8": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "mongoose": "^9.9.3",
    "prisma": "^6.19.3",
    "tsup": "^8.0.0",
    "turbo": "latest",
    "typescript": "^5.4.0",
    "vitepress": "^1.5.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "badges": "node scripts/generate-coverage-badges.mjs",
    "bench": "node scripts/benchmark.mjs",
    "build": "turbo build",
    "bump": "node scripts/bumpVersion.mjs",
    "changelog": "node scripts/changelog.mjs",
    "check:ask-shapes": "node scripts/checkAskShapes.mjs",
    "check:corpus": "node scripts/checkCorpusBaseline.mjs",
    "check:coverage": "node scripts/checkCoverageBaseline.mjs",
    "check:coverage-packages": "node scripts/checkCoveragePackages.mjs",
    "check:diagrams": "node scripts/checkDiagrams.mjs",
    "check:dispatch": "node scripts/checkProtocolDispatch.mjs",
    "check:doc-links": "node scripts/checkDocLinks.mjs",
    "check:findings": "node scripts/checkFindingsCatalog.mjs",
    "check:dogfood": "node scripts/checkDogfoodBaseline.mjs",
    "check:examples": "node scripts/checkExamples.mjs",
    "check:fuzz": "npm run -w @suss/differential check:fuzz",
    "check:fuzz-python": "npm run -w @suss/differential fuzz:python",
    "check:metadata-wiring": "node scripts/checkMetadataWiring.mjs",
    "check:name-syntax": "node scripts/checkNameSyntax.mjs",
    "check:packs": "node scripts/checkPacks.mjs",
    "check:perf": "node scripts/checkPerfBaseline.mjs",
    "check:publish": "node scripts/preparePublish.mjs --check",
    "check:self": "turbo check:self",
    "check:style": "node scripts/checkStyle.mjs",
    "check:vocabulary": "node scripts/checkPackVocabulary.mjs",
    "predocs:build": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generateLlmsTxt.ts",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "dogfood": "node scripts/dogfood.mjs",
    "format": "biome format --write .",
    "fuzz:long": "npm run -w @suss/differential fuzz:long",
    "land": "node scripts/land.mjs",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "prepare": "husky",
    "prepare:publish": "node scripts/preparePublish.mjs",
    "pretest": "node scripts/assertOwnWorkspace.mjs",
    "profile": "node scripts/profile.mjs",
    "release": "node scripts/release.mjs",
    "resolution:baseline": "npm run -w @suss/resolution-fuzz baseline",
    "test": "turbo test --concurrency=3",
    "test:acceptance": "npm run -w @suss/acceptance test",
    "test:badges": "npm run test:coverage && npm run badges",
    "test:coverage": "turbo test:coverage --concurrency=3",
    "typecheck": "tsc --build tsconfig.typecheck.json",
    "fuzz:properties": "vitest run packages/datalog/src packages/resolution/src"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ],
    "**/coverage/coverage-summary.json": [
      "node scripts/normalize-coverage-summary.mjs"
    ]
  }
}
