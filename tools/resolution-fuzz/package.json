{
  "name": "@suss/resolution-fuzz",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Generates fact bases over the resolution vocabulary and compares what the rules derive against a committed baseline. Internal; never published.",
  "license": "Apache-2.0",
  "author": "Nimbus Cloud AI LLC",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "baseline": "RESOLUTION_BASELINE=update vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@suss/datalog": "*",
    "@suss/resolution": "*"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*"
  }
}
